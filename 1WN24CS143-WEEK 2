        "\n",
        "\n",
        "def moves(state):\n",
        "\n",
        "    result = []\n",
        "\n",
        "    zero = state.index(0)\n",
        "\n",
        "    row = zero // 3\n",
        "    col = zero % 3\n",
        "\n",
        "    directions = [\n",
        "        (-1, 0),   # Up\n",
        "        (1, 0),    # Down\n",
        "        (0, -1),   # Left\n",
        "        (0, 1)     # Right\n",
        "    ]\n",
        "\n",
        "    for dr, dc in directions:\n",
        "\n",
        "        r = row + dr\n",
        "        c = col + dc\n",
        "\n",
        "        if 0 <= r < 3 and 0 <= c < 3:\n",
        "\n",
        "            new_zero = r * 3 + c\n",
        "\n",
        "            new_state = state.copy()\n",
        "\n",
        "            new_state[zero], new_state[new_zero] = \\\n",
        "                new_state[new_zero], new_state[zero]\n",
        "\n",
        "            result.append(new_state)\n",
        "\n",
        "    return result\n",
        "\n",
        "\n",
        "def IDS(start):\n",
        "\n",
        "    depth = 0\n",
        "\n",
        "    while True:\n",
        "\n",
        "        print(\"Searching at depth:\", depth)\n",
        "\n",
        "        result = DLS(start, depth, [start])\n",
        "\n",
        "        if result is not None:\n",
        "            return result\n",
        "\n",
        "        depth += 1\n",
        "\n",
        "\n",
        "\n",
        "def DLS(state, depth, path):\n",
        "\n",
        "    if state == goal:\n",
        "        return path\n",
        "\n",
        "    if depth == 0:\n",
        "        return None\n",
        "\n",
        "    for child in moves(state):\n",
        "\n",
        "        if child not in path:\n",
        "\n",
        "            result = DLS(\n",
        "                child,\n",
        "                depth - 1,\n",
        "                path + [child]\n",
        "            )\n",
        "\n",
        "            if result is not None:\n",
        "                return result\n",
        "\n",
        "    return None\n",
        "\n",
        "\n",
        "def display(state):\n",
        "\n",
        "    print(state[0], state[1], state[2])\n",
        "    print(state[3], state[4], state[5])\n",
        "    print(state[6], state[7], state[8])\n",
        "    print()\n",
        "\n",
        "start = [1, 2, 3,\n",
